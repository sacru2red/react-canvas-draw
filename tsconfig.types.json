    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "./type",
    "declarationDir": "./type",
    "lib": ["dom", "es2015"]
  },
  "include": ["type-source/**/*"],
  "exclude": ["node_modules", "es", "lib", "umd", "demo", "tests"]
}

