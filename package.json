{
  "name": "@sacru2red/react-canvas-draw",
  "version": "2.0.0",
  "description": "A simple yet powerful canvas-drawing component for React.",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "type/index.d.ts",
  "files": [
    "css",
    "es",
    "lib",
    "umd",
    "type"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:es && npm run build:cjs && npm run build:umd",
    "build:types": "tsc -p tsconfig.types.json",
    "build:es": "vite build --config vite.config.es.ts",
    "build:cjs": "vite build --config vite.config.cjs.ts",
    "build:umd": "vite build --config vite.config.umd.ts",
    "build:demo": "vite build --config demo/vite.config.ts",
    "clean": "rimraf es lib umd type demo/dist",
    "dev": "vite --config demo/vite.config.ts",
    "start": "npm run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run build:demo && gh-pages -d demo/dist",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "prepare": "husky",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "npx release-it",
    "tsc": "tsc -p tsconfig.types.json"
  },
  "dependencies": {
    "lazy-brush": "^2.0.1",
    "prop-types": "^15.6.2",
    "resize-observer-polyfill": "^1.5.0"
  },
  "peerDependencies": {
    "react": ">= 16"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "all-contributors-cli": "^6.26.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-prettier": "^5.5.5",
    "gh-pages": "^6.3.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.2.7",
    "neostandard": "^0.12.2",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "release-it": "^19.2.4",
    "rimraf": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "author": {
    "name": "sacu2red",
    "email": "sacu2red@gmail.com"
  },
  "homepage": "https://github.com/sacru2red/react-canvas-draw/",
  "license": "MIT",
  "repository": "https://github.com/sacru2red/react-canvas-draw",
  "bugs": {
    "url": "https://github.com/sacru2red/react-canvas-draw/issues"
  },
  "keywords": [
    "react-component",
    "react",
    "reactjs",
    "canvas",
    "drawing"
  ],
  "volta": {
    "node": "24.13.0",
    "npm": "11.8.0"
  }
}
